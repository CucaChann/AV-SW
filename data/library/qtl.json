      "params": {
        "variants": [
          {
            "variant": "dynamic-white-tunable",
            "minLengthIn": 12,
            "maxLengthIn": 191,
            "lengthIncrementIn": 2,
            "lengthModes": [
              "exact",
              "optimal"
            ],
            "optimalRequiresChart": true
          }
        ]
      },
      "source": {
        "sourceId": "qtl-kurv-tunable-guide",
        "locator": "A11 LENGTH (IN) / A12 EXACT/OPTIMAL"
