      "review": {
        "status": "proposed",
        "proposedBy": "chatgpt",
        "proposedOn": "2026-09-25",
        "notes": "QTL calls 3% a reasonable default for most residential/general commercial work. This rule does not invent wire resistance; predicted wire length remains a separate sourced calculation."
